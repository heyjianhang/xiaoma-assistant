# 模型服务：聊天、Embedding、重排统一使用这套 URL + Key
MODEL_BASE_URL=https://your-workspace.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
MODEL_API_KEY=

# 前端可选择的聊天模型，服务端与网关目录取交集
CHAT_MODEL_IDS=qwen3.8-flash,glm-5.3,deepseek-v4.1-flash
# 单轮预算：steps 是图步骤，不是用户聊天轮数；重试仍受总超时限制
CHAT_MAX_STEPS=512
CHAT_TIMEOUT_SECONDS=900
CHAT_MODEL_CALL_LIMIT=64
CHAT_TOOL_CALL_LIMIT=128
CHAT_MODEL_TIMEOUT_SECONDS=180
# 0：跟随所选模型 Profile 的输出上限，再按本次输入占用动态收紧
CHAT_MAX_OUTPUT_TOKENS=0
# CHAT_TEMPERATURE=0.7  # 不填则遵循提供方默认，兼容不同模型

# 仅对连接失败、429、5xx等瞬时故障重试；已输出文字的模型流不自动重放
CHAT_MODEL_MAX_RETRIES=2
CHAT_TOOL_MAX_RETRIES=2
CHAT_REPEATED_TOOL_FAILURE_LIMIT=3
CHAT_RETRY_INITIAL_DELAY=1

# 按模型窗口比例整理历史；原始聊天记录保留
CHAT_SUMMARY_TRIGGER_FRACTION=0.75
CHAT_SUMMARY_KEEP_FRACTION=0.25
# 资料缺失时的应用预算；网关实际窗口更小时可显式指定，0使用公共资料
CHAT_CONTEXT_FALLBACK_TOKENS=128000
CHAT_CONTEXT_WINDOW_TOKENS=0
# 主回答跟随 Profile；内部总结任务独立配置输出预算
CHAT_SUMMARY_MAX_OUTPUT_TOKENS=16384
# 可选绝对预算覆盖；0使用上面的百分比
CHAT_SUMMARY_TRIGGER_TOKENS=0
CHAT_SUMMARY_KEEP_TOKENS=0

# 各用途的模型与检索参数
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_DIMENSIONS=1024
RERANK_MODEL=qwen3.7-text-rerank
RERANK_ENABLED=true
RETRIEVAL_CANDIDATES=20

# PDF 解析（独立服务）
MINERU_BASE_URL=https://mineru.net
MINERU_API_KEY=
MINERU_MODEL_VERSION=vlm

# 本地数据库与文件存储（init_local.py 自动生成数据库密码）
DATABASE_URL=postgresql+asyncpg://xiaoma:CHANGE_ME@127.0.0.1:15433/xiaoma
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_PORT=15433
KNOWLEDGE_SCHEMA=knowledge
STORAGE_ROOT=./var/documents

# 观测（可选）
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=xiaoma-assistant

# 分块、重试、超时和批量大小使用代码默认值；需要调整时可按 Settings 字段追加。

# 业务库使用独立只读账号，由 scripts/import_business.py 自动配置
BUSINESS_DATABASE_URL=
BUSINESS_SCHEMA=business_v1

# 访问认证：init_access.py 生成密码与哈希；HTTPS 部署设 Secure=true
ADMIN_PASSWORD_HASH=
WEB_ORIGIN=http://127.0.0.1:3002
AUTH_COOKIE_SECURE=false
SESSION_HOURS=24
