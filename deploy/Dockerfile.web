FROM node:26.8.1-bookworm-slim AS builder
RUN npm install --global pnpm@11.25.0
WORKDIR /app/apps/web
COPY apps/web/package.json apps/web/pnpm-lock.yaml apps/web/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY apps/web ./
COPY tests/acceptance /app/tests/acceptance
ENV NEXT_TELEMETRY_DISABLED=1 NODE_OPTIONS=--max-old-space-size=1536 BACKEND_URL=http://api:2025
RUN pnpm build

FROM node:26.8.1-bookworm-slim AS runner
WORKDIR /app
ENV NODE_ENV=production HOSTNAME=0.0.0.0 PORT=3002 NEXT_TELEMETRY_DISABLED=1 BACKEND_URL=http://api:2025
COPY --from=builder --chown=node:node /app/apps/web/.next/standalone ./
COPY --from=builder --chown=node:node /app/apps/web/.next/static ./.next/static
COPY --from=builder --chown=node:node /app/apps/web/public ./public
USER node
EXPOSE 3002
CMD ["node", "server.js"]
