FROM python:3.12-slim-bookworm
RUN python -m pip install --no-cache-dir uv==0.12.7
WORKDIR /app
COPY apps/api/pyproject.toml apps/api/uv.lock ./apps/api/
RUN UV_PROJECT_ENVIRONMENT=/opt/venv UV_PYTHON_DOWNLOADS=never uv sync --project apps/api --locked --no-dev --no-install-project --no-cache
COPY apps/api/src ./apps/api/src
COPY skills ./skills
COPY third_party ./third_party
COPY scripts ./scripts
ENV PATH="/opt/venv/bin:$PATH" PYTHONPATH=/app/apps/api/src PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
RUN useradd --create-home --uid 1000 app && mkdir -p /app/var/documents && chown -R app:app /app/var
USER app
EXPOSE 2025
CMD ["uvicorn", "xiaoma.app:app", "--host", "0.0.0.0", "--port", "2025", "--no-access-log"]
